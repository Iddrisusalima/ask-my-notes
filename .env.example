# Ask My Docs — example environment file.
#
# Copy this file to `.env` and edit the values you want to change:
#   Copy-Item .env.example .env
#
# `.env` is git-ignored and must never be committed. Every value below is a
# placeholder. There is no real secret in this file.
#
# An absent variable and a variable set to the empty string are treated
# identically for every setting except OPENAI_API_KEY. Leaving a line commented
# out applies the documented default.
#
# The nine integer settings are parsed strictly: surrounding whitespace is
# trimmed, but "500.0", "5e2", "1_000", and "abc" are all rejected.


# --- Embedding provider -----------------------------------------------------

# Which embedding provider to use.
# Default: sentence-transformers
# Permitted: exactly `openai` or `sentence-transformers`, matched
#            case-insensitively after trimming surrounding whitespace.
# The local provider is the default so the paid remote path is always an
# explicit choice.
ASKMYDOCS_PROVIDER=sentence-transformers

# Embedding model name.
# Default: sentence-transformers/all-MiniLM-L6-v2  (provider sentence-transformers)
#          text-embedding-3-small                  (provider openai)
# Permitted: any non-empty string. An unknown model name surfaces later as a
#            provider failure, not as a configuration error.
ASKMYDOCS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI API key. PLACEHOLDER ONLY — put your real key in `.env`, never here.
# Default: none. There is no default and no fallback.
# Required only when ASKMYDOCS_PROVIDER is `openai`; with the local provider
# this variable is never read. Must be non-empty and not whitespace-only.
# The key is never printed, logged, or written to any report: all output passes
# through the Reporter, which substitutes a fixed redaction marker for the whole
# key and for every substring of it at least 8 characters long.
OPENAI_API_KEY=sk-your-key-here


# --- Notes and chunking -----------------------------------------------------

# Folder holding the PDF and markdown notes, relative to the repository root or
# absolute.
# Default: sample-notes
# Permitted: a path that exists and resolves to a directory at scan time.
ASKMYDOCS_NOTES_FOLDER=sample-notes

# Chunk length in Unicode code points.
# Default: 500
# Permitted range: 1 to 10000 inclusive.
ASKMYDOCS_CHUNK_SIZE=500

# Overlap between consecutive chunks, in Unicode code points.
# Default: 50
# Permitted range: 0 to ASKMYDOCS_CHUNK_SIZE minus 1, inclusive.
ASKMYDOCS_CHUNK_OVERLAP=50


# --- Provider request behaviour ---------------------------------------------

# Provider request timeout, in seconds.
# Default: 30
# Permitted range: 1 to 300 inclusive.
ASKMYDOCS_REQUEST_TIMEOUT=30

# Maximum retry attempts for a transient provider failure.
# Default: 3
# Permitted range: 0 to 10 inclusive. 0 means no retries at all.
ASKMYDOCS_MAX_RETRY_ATTEMPTS=3

# Maximum input length per text, in Unicode code points. Over-long texts are
# rejected before any request is issued, so they cost nothing.
# Default: 8000
# Permitted range: 1 to 100000 inclusive.
ASKMYDOCS_MAX_INPUT_LENGTH=8000

# Maximum texts sent in one provider request.
# Default: 64
# Permitted range: 1 to 2048 inclusive.
ASKMYDOCS_MAX_BATCH_SIZE=64


# --- Cost guardrail ---------------------------------------------------------

# Maximum total chunks embedded in a single pipeline run. Checked after chunking
# and before the first request, so exceeding it costs nothing.
# Default: 2000
# Permitted range: 1 to 1000000 inclusive.
ASKMYDOCS_MAX_CHUNKS_PER_RUN=2000


# --- Advanced ---------------------------------------------------------------

# Expected embedding dimensionality, used to detect a model change between runs.
# Default: unset. Leave it unset: the dimensionality is resolved offline for
# known models and otherwise discovered from the first successful response.
# Set it only to override that resolution.
# Permitted: a positive integer.
# ASKMYDOCS_EMBEDDING_DIM=
